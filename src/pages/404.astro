---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<BaseLayout 
  title="Page Not Found - Ricardo G. Sousa"
  description="The page you're looking for doesn't exist."
>
  <Navigation />
  
  <main style="padding-top: 6rem;">
    <section class="section">
      <div class="container max-w-4xl text-center">
        <div class="mb-12">
          <h1 class="text-6xl font-bold text-gray-900 mb-4">404</h1>
          <h2 class="text-2xl font-semibold text-gray-700 mb-6">Page Not Found</h2>
          <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">
            The page you're looking for doesn't exist. It might have been moved, deleted, or you entered the wrong URL.
          </p>
        </div>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/" class="btn btn-primary" onclick="Lit.event('404-home-click')">
            Go Home
          </a>
          <a href="/blog" class="btn btn-secondary" onclick="Lit.event('404-blog-click')">
            Browse Blog
          </a>
          <a href="/publications" class="btn btn-secondary" onclick="Lit.event('404-publications-click')">
            View Publications
          </a>
        </div>
        
        <div class="mt-12">
          <p class="text-sm text-gray-500">
            If you believe this is an error, please 
            <a href="#" id="contact-email-404" class="text-gray-700 underline hover:text-gray-900" onclick="Lit.event('404-contact-click')">
              contact me
            </a>.
          </p>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const currentPath = window.location.pathname;
    const referrer = document.referrer;
    
    // Setup email obfuscation for contact link
    const emailElement = document.getElementById('contact-email-404') as HTMLAnchorElement;
    if (emailElement) {
      let emailRevealed = false;
      
      emailElement.addEventListener('click', function(e) {
        e.preventDefault();
        if (!emailRevealed) {
          const email = 'ricardo' + '@' + 'rsousa.co';
          emailElement.href = 'mailto:' + email;
          emailRevealed = true;
          if (typeof (window as any).Lit !== 'undefined') {
            (window as any).Lit.event('email-reveal', { metadata: { source: '404' } });
          }
          window.location.href = emailElement.href;
        }
      });
    }
    
    // Track the 404 error with details
    if (typeof (window as any).Lit !== 'undefined') {
      (window as any).Lit.event('404-error', {
        metadata: {
          path: currentPath,
          referrer: referrer || 'direct',
          userAgent: navigator.userAgent.substring(0, 100)
        }
      });
    }
    
  });
</script>

<style>
  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  
  .btn-primary {
    background-color: #111827;
    color: white;
  }
  
  .btn-primary:hover {
    background-color: #374151;
    transform: translateY(-1px);
  }
  
  .btn-secondary {
    background-color: #f3f4f6;
    color: #111827;
  }
  
  .btn-secondary:hover {
    background-color: #e5e7eb;
    transform: translateY(-1px);
  }
</style>
