---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

---

<BaseLayout 
  title="About - Ricardo G. Sousa"
  description="Learn more about Ricardo G. Sousa's background in AI, machine learning, and technology leadership."
>
  <Navigation />
  
  <main style="padding-top: 6rem;">
    <!-- Hero Section -->
    <section class="section">
      <div class="container">
        <div class="grid grid-2 gap-12 items-center">
          <div>
            <h1 class="mb-6">Hi, I am Ricardo G. Sousa</h1>
            <p class="text-xl text-gray-600 mb-8 leading-relaxed">
              With over a decade of experience in driving the development and successful launch of innovative AI platforms, I bring my passion for leveraging cutting-edge technologies and fostering innovation to help businesses harness the power of AI.
            </p>
            
            <ul class="space-y-3 text-gray-700 mb-8" style="list-style-type: '→ '; padding-left: 1.5rem;">
              <li>
                Implementing cutting-edge machine learning and computer vision technologies
              </li>
              <li>
                Enabling AI platforms that unlock full value of data
              </li>
            </ul>
            
            <div class="flex gap-4">
              <a href="/blog" class="btn btn-primary">Read My Blog</a>
              <a href="/publications" class="btn btn-secondary">View Publications</a>
            </div>
          </div>
          
          <div class="relative">
            <div class="bg-white p-8 rounded-2xl shadow-lg">
              <img 
                src="/images/author/ricardo.png" 
                alt="Ricardo G. Sousa" 
                class="w-full h-80 object-cover rounded-lg mb-6"
              />
              <div class="text-center">
                <h3 class="text-xl font-semibold mb-2">Ricardo G. Sousa</h3>
                <p class="text-gray-600 mb-4">AI Solutions Expert & Researcher</p>
                
                <!-- Social Links -->
                <div class="flex justify-center gap-4">
                  <a id="email-link" href="#" class="text-gray-600 hover:text-blue-600">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                      <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                    </svg>
                  </a>
                  <a href="https://github.com/rjgsousa" target="_blank" rel="noopener" class="text-gray-600 hover:text-gray-900" onclick="umami.track('social-github')">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                  </a>
                  <a href="https://www.linkedin.com/in/rjgsousa" target="_blank" rel="noopener" class="text-gray-600 hover:text-blue-700" onclick="umami.track('social-linkedin')">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                  </a>
                  <a href="https://masto.ai/@rjgsousa" target="_blank" rel="noopener" class="text-gray-600 hover:text-purple-600" onclick="umami.track('social-mastodon')">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.10 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054c1.517.363 3.072.546 4.632.546.376 0 .75 0 1.125-.01 1.57-.044 3.224-.124 4.768-.422.038-.008.077-.015.11-.024 2.435-.464 4.753-1.92 4.989-5.604.008-.145.03-1.52.03-1.67.002-.512.167-3.63-.024-5.545zm-3.748 9.195h-2.561V8.29c0-1.309-.55-1.976-1.67-1.976-1.23 0-1.846.79-1.846 2.35v3.403h-2.546V8.663c0-1.56-.617-2.35-1.848-2.35-1.112 0-1.668.668-1.67 1.977v6.218H4.822V8.102c0-1.31.337-2.35 1.011-3.12.696-.77 1.608-1.164 2.74-1.164 1.311 0 2.302.5 2.962 1.498l.638 1.06.638-1.06c.66-.999 1.65-1.498 2.96-1.498 1.13 0 2.043.395 2.74 1.164.675.77 1.012 1.81 1.012 3.12z"/>
                    </svg>
                  </a>
                  <a href="https://www.instagram.com/rjgsousa" target="_blank" rel="noopener" class="text-gray-600 hover:text-pink-600" onclick="umami.track('social-instagram')">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                  </a>
                </div>
                
                <!-- Academic Links -->
                <div class="flex justify-center gap-4 mt-4 pt-4 border-t border-gray-200">
                  <a href="https://scholar.google.com/citations?user=L1rTgf4AAAAJ&hl=en" target="_blank" rel="noopener" class="text-gray-600 hover:text-blue-600" title="Google Scholar" onclick="umami.track('academic-scholar')">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/>
                    </svg>
                  </a>
                  <a href="https://dblp.org/pid/163/4234.html" target="_blank" rel="noopener" class="text-gray-600 hover:text-orange-600" title="DBLP" onclick="umami.track('academic-dblp')">
                    <img src="https://cdn4.iconfinder.com/data/icons/logos-brands-5/24/dblp-512.png" alt="DBLP" class="w-5 h-5" />
                  </a>
                  <a href="https://orcid.org/0000-0001-8822-5412" target="_blank" rel="noopener" class="text-gray-600 hover:text-green-600" title="ORCID" onclick="umami.track('academic-orcid')">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947 0 .525-.422.947-.947.947-.525 0-.946-.422-.946-.947 0-.525.421-.947.946-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.016-5.325 5.016h-3.919V7.416zm1.444 1.303v7.444h2.297c2.359 0 3.81-1.444 3.81-3.722 0-2.016-1.3-3.722-3.81-3.722h-2.297z"/>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience Section -->
    <section class="section bg-gray-50">
      <div class="container">
        <h2 class="text-center mb-12">Professional Experience</h2>
        
        <div class="max-w-4xl mx-auto space-y-8">
          <div class="bg-white p-8 rounded-lg shadow-sm">
            <h3 class="text-xl font-semibold mb-2">AI Solutions Expert</h3>
            <p class="text-gray-600 mb-4">Independent Consultant • Present</p>
            <p class="text-gray-700 leading-relaxed">
              Helping businesses harness the power of AI through cutting-edge machine learning and computer vision technologies. 
              Focusing on developing innovative AI platforms that unlock the full value of data.
            </p>
            <p class="text-gray-600 mt-4">
              Founder of <a href="https://continuum-pulse.org/" target="_blank" rel="noopener" class="text-blue-600 hover:text-blue-800 underline" onclick="umami.track('external-continuum-pulse')">Continuum Pulse</a> - Bridging AI innovation with real-world applications.
            </p>
          </div>
          
          <div class="bg-white p-8 rounded-lg shadow-sm">
            <h3 class="text-xl font-semibold mb-2">Research & Development</h3>
            <p class="text-gray-600 mb-4">Academic & Industry Collaboration</p>
            <p class="text-gray-700 leading-relaxed">
              Extensive research experience in machine learning, computer vision, and conversational AI. 
              Published numerous papers in top-tier conferences and journals, contributing to the advancement of AI technologies.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Research Interests -->
    <section class="section">
      <div class="container">
        <h2 class="text-center mb-12">Research Interests</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto">
          <div class="text-center">
            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
            </div>
            <h3 class="font-semibold mb-2">Machine Learning</h3>
            <p class="text-gray-600 text-sm">Ordinal classification, transfer learning, neural networks</p>
          </div>
          
          <div class="text-center">
            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
              </svg>
            </div>
            <h3 class="font-semibold mb-2">Computer Vision</h3>
            <p class="text-gray-600 text-sm">Fashion image analysis, object detection, medical imaging</p>
          </div>
          
          <div class="text-center">
            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
              </svg>
            </div>
            <h3 class="font-semibold mb-2">Conversational AI</h3>
            <p class="text-gray-600 text-sm">Multimodal agents, intent detection, slot filling</p>
          </div>
          
          <div class="text-center">
            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
              </svg>
            </div>
            <h3 class="font-semibold mb-2">NLP</h3>
            <p class="text-gray-600 text-sm">Natural language processing and understanding</p>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </main>

<script>
  import { setupEmailObfuscation } from '../utils/email-obfuscation';
  setupEmailObfuscation('email-link');
</script>
</BaseLayout>
